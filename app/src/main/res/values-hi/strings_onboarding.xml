    </plurals>
    <plurals name="onb_import_transactions_found">
        <item quantity="one">लेन-देन मिला</item>
        <item quantity="other">लेन-देन मिले</item>
    </plurals>
    <string name="onb_import_just_found">अभी मिले</string>
</resources>
